.page { min-height: 100vh; padding: 28rpx 28rpx 180rpx; box-sizing: border-box; background: #f5f8f6; color: #263a33; }
.header { margin: 16rpx 0 32rpx; }.title { display: block; font-size: 40rpx; font-weight: 700; }.subtitle { display: block; margin-top: 10rpx; color: #72847d; font-size: 26rpx; }
.notice { margin-bottom: 20rpx; padding: 20rpx; border-radius: 8rpx; background: #fff1ed; color: #bd4c34; font-size: 26rpx; }.loading { padding: 80rpx 0; text-align: center; color: #72847d; }
.seat-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; }.seat-tile { min-height: 200rpx; padding: 24rpx; border: 2rpx solid #d6e2dc; border-left-width: 10rpx; border-radius: 10rpx; background: #fff; box-sizing: border-box; }.seat-tile.selected { box-shadow: 0 0 0 4rpx rgba(15, 95, 73, .18); }
.seat-number { display: block; font-size: 38rpx; font-weight: 700; }.seat-name { display: block; margin-top: 8rpx; font-size: 26rpx; }.seat-meta { display: block; margin-top: 22rpx; color: #72847d; font-size: 22rpx; }.seat-state { display: block; margin-top: 10rpx; font-size: 22rpx; }
.status-0 { border-color: #24a067; }.status-0 .seat-state { color: #177549; }.status-1 { border-color: #e08a2e; opacity: .72; }.status-1 .seat-state { color: #a85513; }.status-2 { border-color: #4e88c7; opacity: .72; }.status-2 .seat-state { color: #2165a7; }.status-3 { border-color: #7f8793; opacity: .72; }.status-3 .seat-state { color: #5a6470; }
.footer { position: fixed; z-index: 2; right: 0; bottom: 0; left: 0; padding: 22rpx 28rpx 34rpx; background: #fff; box-shadow: 0 -4rpx 18rpx rgba(26, 71, 55, .09); }.selection { min-height: 32rpx; margin-bottom: 12rpx; color: #40574f; font-size: 24rpx; }.primary { border-radius: 8rpx; background: #0f5f49; color: #fff; font-size: 30rpx; }
