<view class="page">
  <view class="header">
    <text class="title">餐厅座位</text>
    <text class="subtitle">扫码确认桌号后开始点餐</text>
  </view>
  <view wx:if="{{error}}" class="notice">{{error}}</view>
  <view wx:if="{{loading}}" class="loading">正在加载座位信息...</view>
  <view wx:else class="seat-grid">
    <view wx:for="{{seats}}" wx:key="id" class="seat-tile status-{{item.status}} {{selectedSeat && selectedSeat.id === item.id ? 'selected' : ''}}" data-seat="{{item}}" bindtap="selectSeat">
      <text class="seat-number">{{item.seatNumber}}</text>
      <text class="seat-name">{{item.name || '未命名座位'}}</text>
      <text class="seat-meta">{{item.area || '未分区'}} · {{item.capacity || 0}} 人</text>
      <text class="seat-state">{{item.status === 0 ? '空闲' : item.status === 1 ? '使用中' : item.status === 2 ? '已预订' : '清洁中'}}</text>
    </view>
  </view>
  <view class="footer">
    <view wx:if="{{selectedSeat}}" class="selection">已选：{{selectedSeat.seatNumber}} {{selectedSeat.name || ''}}</view>
    <button class="primary" bindtap="startOrdering">确认座位并点餐</button>
  </view>
</view>
